<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modder Tools — sitemap.xml

  Replace https://example.com with your real domain everywhere below.

  Because index.html is a single-page app that routes app-details/app-download
  views client-side via a URL hash (#/app-details?id=123) rather than separate
  server-rendered pages, this file lists the home page plus placeholder <url>
  blocks showing the pattern to repeat for every published app.

  IMPORTANT SEO CAVEAT: most crawlers do not fetch content behind a #hash, so
  listing hash URLs here has limited indexing value on its own. For app pages
  to actually rank, generate this file dynamically (e.g. a small script or
  Cloud Function that reads /apps from Firebase whenever an app is published)
  AND consider adding lightweight server-side rendering or prerendering
  (a static snapshot per app, or a redirect service) for the app-details URLs
  so crawlers see real content rather than an empty shell.
-->
<urlset xmlns="http://www.sitemap.org/schemas/sitemap/0.9">

  <!-- Home -->
  <url>
    <loc>https://moddertools.vercel.app/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- ============================================================
       Repeat one <url> block per PUBLISHED app/tool, in this shape.
       id = the Firebase key of the app (apps/{appId}).
       Update <lastmod> to the app's updatedAt whenever it changes.
       ============================================================ -->
  <url>
    <loc>https://moddertools.vercel.app/#/app-details?id=bin.mt.plus</loc>
    <lastmod>2026-01-01</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>

</urlset>
