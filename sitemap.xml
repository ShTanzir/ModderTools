<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modder Tools — sitemap.xml

  index.html is a single-page app that routes app-details views client-side
  via a URL hash (#/app-details?id=123). Search engines generally do not treat
  URL fragments (#...) as separate crawlable/indexable pages, since the
  fragment is never sent to the server — so individual app pages are NOT
  listed here, and listing them would not help indexing.

  Only the home page is listed below, which is what Google will actually
  crawl, render, and index.

  If you want individual app/tool pages to rank on Google (e.g. someone
  searching the exact app name), the durable fix is to move app-details off
  hash routing onto real paths (e.g. /app/{id}) using the History API, with a
  Vercel rewrite so every path serves index.html. Ask if you want this built.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>https://moddertools.vercel.app/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

</urlset>
